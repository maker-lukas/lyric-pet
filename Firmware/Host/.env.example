# Create an app at https://developer.spotify.com/dashboard and add the exact
# redirect URI below to its settings. PKCE means no client secret is needed.
SPOTIPY_CLIENT_ID=your_spotify_app_client_id
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Private Spotify web cookie used only by the self-hosted lyrics API.
SP_DC=your_sp_dc_cookie

# URL of your self-hosted akashrchandran/spotify-lyrics-api instance.
LYRICS_API_URL=http://localhost:8080

# Increase this if lyrics appear too early; decrease it if they appear late.
LYRICS_DELAY_MS=500

# Optional. Leave blank to automatically find a connected XIAO RP2040.
SERIAL_PORT=
